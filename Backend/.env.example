# Server Setup
PORT=5000
CLIENT_ORIGIN=http://localhost:3000

# Secure Database Cloud Connection (Microsoft SQL Server)
# Use either DB_HOST or DB_SERVER to specify the host address
DB_HOST=your-cloud-database-hostname-or-ip
DB_PORT=1433
DB_NAME=SaiVarunERP
DB_USER=your-database-username
DB_PASSWORD=your-database-password

# Connection Security Options
# Evaluated strictly as booleans (=== 'true')
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# Connection Pool Settings
# Optimized for containerized/serverless environments to avoid socket exhaustion
DB_POOL_MAX=5
DB_POOL_MIN=0
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_REAP_INTERVAL=15000
